#!/bin/sh
# cleanup: remove files generated by configure and build.
# Run by R CMD build before building the source tarball.

rm -f src/Makevars
rm -f src/*.o src/*.so src/*.dll
rm -f src/symbols.rds
rm -f config.log config.status
rm -f src/config.log src/config.status
rm -rf autom4te.cache 2>/dev/null || true
rm -rf tools/autom4te.cache 2>/dev/null || true
rm -rf src/autom4te.cache 2>/dev/null || true

exit 0
